node_modules/
dist/
dist-model-smoke/
dist-model-benchmark/
public/vendor/transformers-wasm/
coverage/
playwright-report/
test-results/
*.log
*.tsbuildinfo

# Pinned Chrome-for-Testing build downloaded by scripts/test-browser-lock.mjs
# (420M, reproducible from tests/browser-lock.json — never source).
.cache/

# Linked git worktrees (e.g. .worktrees/cleanfeed-mvp) are registered checkouts,
# never source; git already auto-excludes them, kept explicit for clarity.
.worktrees/

# Serena MCP tool workspace (local dev tooling output, never source).
.serena/

# Benchmark scientific outputs and scratch space are generated, never source.
benchmark/out/
benchmark/work/

# Benchmark datasets are auditable but private; they never enter Git.
benchmark/data/*
!benchmark/data/.gitkeep

# Sanitized evidence is versioned ONLY through a CLOSED allowlist: the tmr-ptbr-v1
# directory is re-included, then everything inside it is ignored except the exact
# seven sanitized files publish-evidence may write. Raw evidence never enters Git
# and publication never uses `git add -f` for source data. The .gitkeep
# placeholder is `git rm`'d once the real evidence is published.
benchmark/evidence/*
!benchmark/evidence/tmr-ptbr-v1/
benchmark/evidence/tmr-ptbr-v1/*
!benchmark/evidence/tmr-ptbr-v1/dataset-summary.json
!benchmark/evidence/tmr-ptbr-v1/split-summary.json
!benchmark/evidence/tmr-ptbr-v1/fit-summary.json
!benchmark/evidence/tmr-ptbr-v1/benchmark-report.json
!benchmark/evidence/tmr-ptbr-v1/benchmark-report.md
!benchmark/evidence/tmr-ptbr-v1/decision.json
!benchmark/evidence/tmr-ptbr-v1/evidence-digest.json

# Model bundles are large, sha256-verified artifacts; never in Git.
public/models/*
!public/models/.gitkeep
# The materialized bundle and any source staging live under public/ and
# stay out of Git (redundant with the rule above, kept explicit for auditability).
public/models/cleanfeed-ptbr-v1/

# The model SOURCE metadata (lock, license, notice, review, manifests) lives
# under models/ and IS tracked — it is small, auditable, and the source of truth.
!models/cleanfeed-ptbr-v1/

# Python bytecode and tool caches from benchmark/lab are regenerated per run.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
