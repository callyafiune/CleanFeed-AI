node_modules/
dist/
dist-model-smoke/
dist-model-benchmark/
public/vendor/transformers-wasm/
coverage/
playwright-report/
test-results/
*.log
*.tsbuildinfo

# Serena MCP tool workspace (local dev tooling output, never source).
.serena/

# Benchmark scientific outputs and scratch space are generated, never source.
benchmark/out/
benchmark/work/

# Benchmark datasets are auditable but private; they never enter Git.
benchmark/data/*
!benchmark/data/.gitkeep

# Model bundles are downloaded artifacts (large, sha256-verified); never in Git.
public/models/*
!public/models/.gitkeep
# The materialized/acquired bundle and any source staging live under public/ and
# stay out of Git (redundant with the rule above, kept explicit for auditability).
public/models/tmr-ai-text-detector/

# The model SOURCE metadata (lock, license, notice, review, manifests) lives
# under models/ and IS tracked — it is small, auditable, and the source of truth.
!models/tmr-ai-text-detector/
