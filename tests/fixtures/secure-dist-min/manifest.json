{
  "manifest_version": 3,
  "name": "Minimal clean fixture",
  "version": "0.0.0",
  "description": "A minimal, allowlist-compliant unpacked extension used only to prove scripts/audit-build.mjs passes a clean build. Never shipped.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "background": {
    "service_worker": "clean.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["clean.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["clean.js"],
      "matches": ["https://www.linkedin.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'; connect-src 'self'"
  }
}
