{
  "manifest_version": 3,
  "name": "Insecure test extension (fixture)",
  "version": "0.0.0",
  "description": "Deliberately insecure unpacked extension used only to prove scripts/audit-build.mjs fails a bad build. Never shipped.",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting",
    "offscreen"
  ],
  "host_permissions": ["<all_urls>"],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "bad.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["bad.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["bad.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'; connect-src 'self'"
  }
}
