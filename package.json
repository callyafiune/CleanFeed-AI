{
  "name": "cleanfeed-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prebuild": "node scripts/copy-transformers-assets.mjs",
    "dev": "vite",
    "build": "vite build && vite build --config vite.manual-analysis.config.ts",
    "postbuild": "node scripts/sanitize-offline-bundle.mjs",
    "test": "vitest",
    "test:e2e": "playwright test",
    "build:model-smoke": "vite build --config vite.model-smoke.config.ts",
    "test:model:smoke": "node scripts/run-real-model-tests.mjs candidate",
    "test:model:release": "node scripts/run-real-model-tests.mjs release",
    "browser:install:test": "node scripts/test-browser-lock.mjs install --lock tests/browser-lock.json",
    "build:model-benchmark": "node scripts/runtime-parity.mjs write --model-manifest models/tmr-ai-text-detector/cleanfeed-model.json --output-dir benchmark/work/model-benchmark && vite build --config vite.model-benchmark.config.ts",
    "test:model-benchmark": "playwright test --config playwright.model-benchmark.config.ts tests/e2e/benchmark-browser-scorer.spec.ts",
    "benchmark": "node benchmark/cli.ts",
    "model:verify:assets": "node scripts/model-lock.mjs --verify public/models/tmr-ai-text-detector",
    "model:verify:metadata": "node scripts/verify-model-bundle.mjs --metadata",
    "model:fetch": "node scripts/acquire-model-assets.mjs",
    "model:verify": "node scripts/verify-model-bundle.mjs --bundle public/models/tmr-ai-text-detector",
    "model:evidence:verify": "npm run benchmark -- verify-published-evidence --evidence-dir benchmark/evidence/tmr-ptbr-v1 --model-dir models/tmr-ai-text-detector",
    "release:activate": "node scripts/activate-model-release.mjs --release models/tmr-ai-text-detector/release.json --profiles models/tmr-ai-text-detector/calibration-profiles.json --evidence-dir benchmark/evidence/tmr-ptbr-v1",
    "audit:model": "node scripts/audit-model-package.mjs --dist dist --metadata models/tmr-ai-text-detector --evidence benchmark/evidence/tmr-ptbr-v1",
    "build:release": "node scripts/run-release-build.mjs",
    "test:e2e:release": "node scripts/build-e2e-release-variants.mjs && playwright test tests/e2e/tmr-release.spec.ts",
    "verify:release": "npm run verify:release:base && npm run test:e2e:release",
    "docs:check": "node scripts/check-doc-links.mjs",
    "audit": "node scripts/audit-build.mjs dist",
    "verify:build": "node scripts/verify-reproducible-build.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && vitest run && npm run build && npm run audit && npm run test:e2e",
    "verify:release:base": "npm run format:check && npm run lint && npm run typecheck && vitest run && npm run model:evidence:verify && npm run model:verify && npm run test:model:release && npm run build:release && npm run audit && npm run audit:model && npm run verify:build && npm run docs:check",
    "lint": "eslint .",
    "typecheck:benchmark": "tsc --noEmit --project tsconfig.benchmark.json",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.node.json && npm run typecheck:benchmark",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^29.1.1",
    "playwright": "^1.57.0",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
